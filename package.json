{
  "name": "lumis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "dev": "concurrently -n mobile,api -c blue,green \"npm run dev:mobile\" \"npm run dev:api\"",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:api": "npm run dev --workspace=apps/api",
    "migrate": "npm run migrate --workspace=apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:mobile": "node --import tsx --test tests/mobile/*.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
