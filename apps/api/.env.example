# Puerto donde escucha la API
PORT=3000

# Secreto para firmar los JWT (cámbialo por uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS (* = cualquiera, suficiente para app móvil)
CORS_ORIGIN=*

# MySQL de XAMPP (valores por defecto: usuario root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lumis
