# Puerto donde escucha la API
PORT=3000

# Secreto para firmar los JWT (cámbialo por uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS (* = cualquiera, suficiente para app móvil)
CORS_ORIGIN=*

# MySQL de XAMPP (valores por defecto: usuario root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lumis

# Panel de plataforma (solo la API de Lumis independiente).
NODE_ENV=development
ADMIN_ORIGIN=http://127.0.0.1:5173
# En producción: NODE_ENV=production y ADMIN_ORIGIN=https://admin-lumis.novaledbolivia.com
# Configura estas dos variables en hPanel SOLO para crear el primer administrador.
# Sin valores por defecto; no guardes tu contraseña real en Git.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador Lumis
# Opcional: enlace HTTPS real de soporte o contacto comercial mostrado en la app.
LUMIS_SUPPORT_URL=
