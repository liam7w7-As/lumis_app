{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "lumis": {
      "extends": "apk",
      "env": {
        "EXPO_PUBLIC_BACKEND": "lumis",
        "EXPO_PUBLIC_API_URL": "https://lumis.novaledbolivia.com",
        "APP_VARIANT": "lumis"
      }
    },
    "novaled": {
      "extends": "apk",
      "env": {
        "LUMIS_ANDROID_ARCHS": "armeabi-v7a,arm64-v8a",
        "EXPO_PUBLIC_BACKEND": "novaled",
        "APP_VARIANT": "novaled",
        "EXPO_PUBLIC_API_URL": "https://sistema.novaledbolivia.com"
      }
    },
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    },
    "apk": {
      "extends": "preview",
      "environment": "production",
      "env": {
        "LUMIS_ANDROID_ARCHS": "armeabi-v7a,arm64-v8a",
        "EXPO_PUBLIC_API_URL": "https://lumis.novaledbolivia.com",
        "EXPO_PUBLIC_BACKEND": "lumis"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
